# Tên project Compose: tiền tố cho tên container, volume và network
COMPOSE_PROJECT_NAME=credit

# Phiên bản image
HADOOP_IMAGE=apache/hadoop:3.4.2
KAFKA_IMAGE=apache/kafka:4.2.2
SPARK_IMAGE=apache/spark:4.1.3-python3
POSTGRES_IMAGE=postgres:17.11-alpine
GRAFANA_IMAGE=grafana/grafana-oss:12.4.3
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0
ADMINER_IMAGE=adminer:6.1.2

# Cổng mở ra máy; chỉ bind 127.0.0.1 nên máy khác trong mạng LAN không truy cập được
BIND_ADDR=127.0.0.1
HDFS_UI_PORT=9870
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_DRIVER_UI_PORT=4040
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8089
ADMINER_PORT=8090
POSTGRES_PORT=5432
GRAFANA_PORT=3000

# ID của cụm Kafka (sinh bằng: docker run --rm apache/kafka:4.2.2 /opt/kafka/bin/kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=uGiaEeUeTAqUqih8x3D23g

# uid/gid của người dùng trên máy, để container ghi file vào work/ đúng chủ sở hữu
HOST_UID=1000
HOST_GID=1000

# Kích thước Spark worker (Docker Desktop nên đặt 7 GB RAM)
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=3g

# Chế độ chạy liên tục (make live-start): số hồ sơ mỗi giây và độ trễ của nhãn (giây)
LIVE_RATE=20
LIVE_OUTCOME_DELAY=30
