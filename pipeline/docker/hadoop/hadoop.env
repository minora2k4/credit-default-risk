# Cấu hình HDFS cho image apache/hadoop. Quy ước: <TÊN-FILE>.<ĐUÔI>_<khóa>=<giá trị>,
# ví dụ HDFS-SITE.XML_dfs.replication=1 thành thẻ <property> trong hdfs-site.xml lúc container khởi động.

# địa chỉ mặc định của HDFS, để gõ `hdfs dfs -ls /datalake` thay vì URL đầy đủ
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

# số bản sao mỗi block; cụm 1 DataNode nên đặt 1
HDFS-SITE.XML_dfs.replication=1
# địa chỉ RPC của NameNode
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# nơi lưu metadata của NameNode và block của DataNode, nằm trong named volume gắn tại /data
HDFS-SITE.XML_dfs.namenode.name.dir=file:///data/hdfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///data/hdfs/data
# tắt kiểm tra quyền giữa các container
HDFS-SITE.XML_dfs.permissions.enabled=false
# bật REST API WebHDFS
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# Docker không có reverse DNS cho IP container; không tắt thì NameNode từ chối DataNode đăng ký
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
# danh sách DataNode cần loại khỏi cụm (decommission), mount từ docker/hadoop/exclude/
HDFS-SITE.XML_dfs.hosts.exclude=/opt/hadoop-exclude/dfs.exclude

# heap JVM nhỏ hơn mem_limit để chừa chỗ cho bộ nhớ ngoài heap
HADOOP_HEAPSIZE_MAX=512m
